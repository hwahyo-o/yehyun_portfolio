name = "yehyun-portfolio-api"
main = "src/index.js"
compatibility_date = "2026-08-12"

[vars]
FIREBASE_PROJECT_ID = "yehyun-portfolio"
ALLOWED_ORIGIN = "https://hwahyo-o.github.io"
FRONTEND_URL = "https://hwahyo-o.github.io/yehyun_portfolio"
GOOGLE_REDIRECT_URI = "https://yehyun-portfolio-api.ajas03974.workers.dev/oauth/google/callback"
GOOGLE_LOGIN_REDIRECT_URI = "https://yehyun-portfolio-api.ajas03974.workers.dev/oauth/google/login-callback"

[[d1_databases]]
binding = "DB"
database_name = "yehyun-portfolio"
database_id = "3a72f8d7-cf47-4afc-8b05-1773c67a0b7e"

# Store all values below as Cloudflare Worker Secrets, never in this file:
# FIREBASE_WEB_API_KEY
# SESSION_ENCRYPTION_KEY
# GOOGLE_CLIENT_ID
# GOOGLE_CLIENT_SECRET
# GOOGLE_REFRESH_TOKEN
# GOOGLE_TOKEN_ENCRYPTION_KEY
# CLOUDFLARE_API_TOKEN is only a GitHub Actions secret, not a Worker variable.
